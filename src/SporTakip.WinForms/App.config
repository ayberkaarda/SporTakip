<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <!-- Microsoft.Data.SqlClient'ta Encrypt varsayılan olarak açık; yerel LocalDB için sertifikaya güvenilir. -->
        <add name="SporTakip" connectionString="Server=(localdb)\MSSQLLocalDB;Database=SporTakip;Integrated Security=True;TrustServerCertificate=True;" providerName="Microsoft.Data.SqlClient" />
    </connectionStrings>
</configuration>
